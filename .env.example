# --- Database (Drizzle ORM / PostgreSQL via Supabase session pooler) ---
# From Supabase Dashboard -> Project Settings -> Database -> Connection string ->
# pick the "Session pooler" (IPv4) template. Username is "<project-ref>.<db-user>" and the
# password is your database password (URL-encode special chars with %XX).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase (project-level) — used from Phase 06 onward ---
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=                                   # Anon/publishable key
SUPABASE_SECRET_KEY=                                        # Service role/secret key
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Auth (Better Auth) — used from Phase 06 onward ---
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Originating URL of the app (http://localhost:3000 in dev)
BETTER_AUTH_URL=http://localhost:3000

# --- AI provider keys (Vercel AI SDK) — used from Phase 23 onward ---
AI_GEMINI_API_KEY=
# Text model for insights. Default gemini-3.1-flash-lite. Every gemini-2.x model is retired
# for newly issued keys (404 "no longer available to new users"), so don't pin one here.
AI_GEMINI_MODEL=
# Voice intake: speech→text and text→speech. Leave blank for the defaults.
# The TTS/transcribe models reject systemInstruction, so the prompt is built in the user turn.
AI_GEMINI_STT_MODEL=
AI_GEMINI_TTS_MODEL=

# --- Demo mode (Phase 25) ---
# Simulated clock offset in minutes for demo sessions (0 = real time).
DEMO_CLOCK_OFFSET_MINUTES=0

# --- Web push (VAPID) ---
# Generate a pair with: npx web-push generate-vapid-keys
# The public key is safe to expose to the browser (it is embedded in the subscription).
# The private key signs every push and MUST stay server-side. Rotating the pair invalidates
# every existing subscription, so clients must re-subscribe (the app does this on next load).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact string pushed services use to reach you on delivery failures, e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:you@example.com

# --- End-to-end tests (Playwright) ---
# The E2E suite registers real accounts and writes to the database, so it must never point at a
# database you care about. Leave unset to reuse DATABASE_URL locally; on CI it is required so a
# throwaway service database is used instead of anything long-lived.
# E2E_DATABASE_URL=postgresql://...