# ==============================================================================
# MedVault - Production & Vercel Environment Variables Guide
# ==============================================================================

# --- Database (PostgreSQL / Supabase Session Pooler) ---
# Required for Drizzle ORM and all database operations.
# Tip: On Supabase, use the "Session Pooler" (IPv4) connection string on port 5432.
DATABASE_URL=postgresql://postgres.bujgsllqckllbnxecygj:dUxLEfqB9UZIozhO@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Supabase API (Project Settings -> API) ---
SUPABASE_URL=https://bujgsllqckllbnxecygj.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://bujgsllqckllbnxecygj.supabase.co/auth/v1/.well-known/jwks.json

# --- Better Auth ---
# 32+ character random string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=medvault_prod_secret_auth_key_replace_with_random_string_32_chars
# Base URL of the deployment (e.g. https://medvault.vercel.app).
# Note: On Vercel, if left empty, MedVault automatically falls back to https://$VERCEL_URL!
BETTER_AUTH_URL=https://medvault.vercel.app

# --- AI Provider (Gemini API for clinical insights & natural language assistance) ---
AI_GEMINI_API_KEY=

# --- Demo Mode ---
DEMO_CLOCK_OFFSET_MINUTES=0
NODE_ENV=production